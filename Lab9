import math
def g(x):
    return math.sqrt(math.log(x))
x = 1.5  
eps = 1e-6
max_iter = 100
i = 0
while i < max_iter:
    try:
        x_next = g(x)
    except ValueError:
        print("Xəta: ln(x) mənfi oldu, kvadrat kök alınmadı.")
        break
    if abs(x_next - x) < eps:
        break
    x = x_next
    i += 1
print("Təqribi kök:", round(x, 6))
print("Iterasiya sayı:", i)

